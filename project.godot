; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Choicer Voicer"
config/version="0.5.2"
run/main_scene="res://scene/menu/opening_screen/opening_screen.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="YeahMaybe/ChoicerVoicer"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/show_image=false
config/icon="uid://di4lswjgvv8hw"
config/windows_native_icon="res://graphic/image/cv_temp_icon.ico"

[audio]

driver/enable_input=true

[autoload]

VolumeService="*res://common/globals/independent_services/volume_service.gd"
MicrophoneService="*res://common/globals/independent_services/microphone_service_dx.gd"
VersionCompatibilityService="*res://common/globals/independent_services/version_compatibility_service.gd"
MathService="*res://common/globals/independent_services/math_service.gd"
NativePackService="*res://common/globals/independent_services/native_pack_service.gd"
FileManager="*res://common/globals/file_manager.gd"
VD="*res://common/globals/vd.gd"
DisplayManager="*res://common/globals/display_manager.gd"
Profile="*res://common/globals/profile.gd"
GMCrust="*res://common/globals/gm_crust.gd"
ProxyMiddlemanMenu="*res://common/globals/proxy_middlemen/proxy_middleman_menu.gd"
M="*res://common/globals/m.gd"
Metro="*res://common/globals/metro.gd"

[debug]

settings/stdout/verbose_stdout=true
gdscript/warnings/narrowing_conversion=0

[display]

window/size/resizable=false
window/stretch/mode="canvas_items"

[editor]

export/convert_text_resources_to_binary=false

[file_customization]

folder_colors={
"res://_notes/": "gray",
"res://audio/": "orange",
"res://game_default/": "purple",
"res://graphic/": "yellow",
"res://model/": "red",
"res://resource/": "green",
"res://scene/": "blue",
"res://scene/match/": "pink",
"res://scene/menu/": "teal",
"res://test/": "pink"
}

