[node name="Label" type="Label" parent="VBoxContainer/VBoxContainer3"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
size_flags_horizontal = 8
theme_override_font_sizes/font_size = 14
text = "Experimental option to see if it affects the \"light of god\" bug, where the gameshow studio is bathed in white light. If turning this option on and disabling volumetric fog fixes or changes the \"light of god\" if you have it, please let me know in its store page community post."
autowrap_mode = 2
