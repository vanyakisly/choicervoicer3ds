[node name="Label" type="Label" parent="VBoxContainer/VBoxContainer"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
size_flags_horizontal = 8
theme_override_font_sizes/font_size = 14
text = "The sampling buffer changes how the game waits between samples from audio that's playing. This only affects Dub Mode, the clip editor preview, and the mic check, because those are the only places that the new setup is being used. I have created multiple options in hopes that at least one will work for all users.

\"Physics Frame\" was the original method, but has an occasional timing issue. I tried fixing this with \"Float Timer\", but at least one user reported sampling happening too quickly with it."
autowrap_mode = 2

