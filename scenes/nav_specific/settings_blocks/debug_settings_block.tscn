[node name="OptionCountdownType" type="OptionButton" parent="VBoxContainer/VBoxContainer2/HBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 32)
layout_mode = 2
clip_text = true
item_count = 2
popup/item_0/text = "Timing Lights"
popup/item_0/id = 0
popup/item_1/text = "2... 1... GO!"
popup/item_1/id = 1

[node name="Label" type="Label" parent="VBoxContainer/VBoxContainer2"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
size_flags_horizontal = 8
theme_override_font_sizes/font_size = 14
text = "How the gameshow counts down to recording.
The default is the \"Timing Lights,\" which make a noise as they tick down, with the final light being silent because it lights up the moment recording actually starts.

It has replaced the \"2-1-GO!\" overlay. That overlay had to wait to disappear before recording began, resulting in a delay between it telling you \"GO!\" and actually recording. It has been included here as a debug option to return to for now."
autowrap_mode = 2

