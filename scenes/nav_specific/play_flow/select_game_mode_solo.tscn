layout_mode = 2
size_flags_vertical = 1
theme_override_colors/font_color = Color(1, 1, 1, 1)
text = "If you want dubbing without turns, scoring, and previews, then Freestyle is what you need!

In Freestyle Dub Mode, the video will play in its entirety and you dub it live. It's one continuous take.

This mode uses special \"Dub Voice Packs\" and is
not compatible with non-dub voice packs."
autowrap_mode = 2

