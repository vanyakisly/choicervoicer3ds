[node name="LblTitle" parent="MarginContainer/Original/MarginContainer/VBoxContainer/HBoxContainer/GameModeInfo/InfoDubMode/VBoxContainer" index="1"]
text = "⭕ Dub Mode ⭕"

[node name="LblDescription" parent="MarginContainer/Original/MarginContainer/VBoxContainer/HBoxContainer/GameModeInfo/InfoDubMode/VBoxContainer" index="2"]
text = "Impersonate a series of voice clips at your leisure,
and then hear your dub over a video!

You can re-record as many times as you wish in
this mode, but you cannot hear your recordings until
the dub is complete.

This mode uses special \"Dub Voice Packs\" and is
not compatible with normal voice packs."

