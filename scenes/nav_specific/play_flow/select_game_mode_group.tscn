[node name="LblTitle" parent="MarginContainer/Original/MarginContainer/VBoxContainer/HBoxContainer/GameModeInfo/InfoStandardGameshow/VBoxContainer" index="1"]
text = "⭕ Gameshow ⭕"

[node name="LblDescription" parent="MarginContainer/Original/MarginContainer/VBoxContainer/HBoxContainer/GameModeInfo/InfoStandardGameshow/VBoxContainer" index="2"]
text = "Step on up to The Choicer Voicer game show studio!
Each round, a voice clip will play for you. Impersonate the
audio as well as you can. The better your performances,
the more points you will receive from a panel of judges.

The contestant with the highest percentage is the winner!"

