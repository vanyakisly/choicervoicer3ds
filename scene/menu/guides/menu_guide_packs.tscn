layout_mode = 2

[node name="Label2" type="Label" parent="Border/HBoxContainer/Sidebar/ColorRect/Pages/PagePlayerPacks/PageContainer/VBoxContainer/ExplainBox_config/HBoxContainer2"]
custom_minimum_size = Vector2(764, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("4_4t6lw")
text = "Lets you specify information about the player. The player's name does NOT use the name of the pack, and will default to \"Player\" if not changed. There are also two color options, which are used for the player's podium and accent colors for their score tracker. Finally, you can customize what phrase the host says when they introduce the player.

You can also assign variant audio files to the player's reactions. If you don't want audio to play for a certain reaction, leave the field blank. You may also use one audio file for multiple reactions.

The name of the file must be typed WITHOUT its file extension.
For example, if a pack has \"talk_cheer.wav\", then it must be assigned as \"talk_cheer\"."
autowrap_mode = 2

