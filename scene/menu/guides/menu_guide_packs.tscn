[node name="Label2" type="Label" parent="Border/HBoxContainer/Sidebar/ColorRect/Pages/PageClips/PageContainer/VBoxContainer/ExplainBox_voice/HBoxContainer2"]
custom_minimum_size = Vector2(764, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("4_4t6lw")
text = "The game will load any WAV, MP3, and OGG file as a voice clip.

BEST PRACTICES:
* Too loud is better than too quiet. Voice clips are judged via WAVEFORM OVERLAP.
    Quiet clips have very small waveforms in-game, and will always score poorly, resulting
    in an unfun experience for players.
* Clips should not include BACKGROUND MUSIC or NOISE. All sound in the clip will be
   sampled by the game. Because performances are judged via waveform overlap, a player
   will fail if their waveforms do not match noisy clips. Consider using a noise remover."
autowrap_mode = 2

