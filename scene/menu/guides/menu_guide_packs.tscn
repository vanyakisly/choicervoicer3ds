[node name="Label2" type="Label" parent="Border/HBoxContainer/Sidebar/ColorRect/Pages/PageHostPacks/PageContainer/VBoxContainer/ExplainBox_config/HBoxContainer2"]
custom_minimum_size = Vector2(764, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("4_4t6lw")
text = "Lets you change the host's dialog. This can also be done in the pack selection menu.

Make sure to change the host's default name. The host does NOT use the pack's name as their name, and the default name is \"Shae\" if you do not change it.

There are a few special strings that will be replaced with variable data during a session:
    <host_name> dynamically uses the name specified in the config file, if desired.
    <player> uses the name of the active player.
    <round> uses the current or upcoming round during the session.
    <points> uses the points earned this round by the active player.

If you are customizing dialog in the pack selection menu:
    </next> will split the dialog into more than one text box.
    You can specify a new line by simply pressing Enter.

If you are customizing dialog in the config file:
    Each dialog event is a string array in the config file. Each string in the array is one text box. Do not use \"</next>\"
    You must specify a new line via \"\\n\""
autowrap_mode = 2

