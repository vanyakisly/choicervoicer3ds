layout_mode = 2
theme_override_fonts/font = ExtResource("4_4t6lw")
text = "An image to use for a player. This image does NOT get scaled or shifted. This means that small images will be small, and large images will be large. For a standard person, the recommended image height is 1000 pixels.

Short players will be blocked by their podium unless you increase the height and leave empty space at the bottom of the image.

If an image fails to load, the default cardboard cutout will be used instead."
autowrap_mode = 2

