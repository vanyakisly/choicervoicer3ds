[node name="Label2" type="Label" parent="Border/HBoxContainer/Sidebar/ColorRect/Pages/PagePlayerPacks/PageContainer/VBoxContainer/ExplainBox_audio_variant/HBoxContainer2"]
custom_minimum_size = Vector2(764, 0)
layout_mode = 2
theme_override_fonts/font = ExtResource("4_4t6lw")
text = "In a feature specific to player packs (since Version 0.4.13),
audio files that can be spoken by the player do not have set names.

A player has a maximum of nine \"reaction\" audio files:
    score_0: plays when earning a score of 0
    score_1: plays when earning a score of 1
    score_2: plays when earning a score of 2
    score_3: plays when earning a score of 3
    score_4: plays when earning a score of 4
    score_5: plays when earning a score of 5
    intro_greet: plays when the host introduces the player
    game_loser: plays when the player loses the session
    game_winner: plays when the player wins the session

By default:
    An audio file named \"talk_cheer\" is assigned to \"score_4\", \"score_5\", and \"game_winner\".
    An audio file named \"talk_upset\" is assigned to \"score_0\", \"score_1\", and \"game_loser\".
    An audio file named \"talk_greet\" is assigned to \"intro_greet\".
    No audio is assigned to \"score_2\" and \"score_3\"."
autowrap_mode = 2

